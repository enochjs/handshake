# Aliyun SSH jump host (handshake server).
HSD_REMOTE_HOST="106.14.219.191"
HSD_REMOTE_USER="fenghe"
HSD_REMOTE_DIR='~/handshake'
HSD_SSH_IDENTITY_FILE="${HOME}/.ssh/id_ed25519"
HSD_SSH_SERVER_ALIVE_INTERVAL="30"
HSD_SSH_SERVER_ALIVE_COUNT_MAX="3"

# Reverse tunnel: Host A => Aliyun => this machine's GitLab
# On Aliyun these bind to 127.0.0.1 (default GatewayPorts=no).
HSD_GITLAB_LOCAL_HTTP_PORT="8080"
HSD_GITLAB_LOCAL_SSH_PORT="2222"
HSD_GITLAB_REMOTE_HTTP_PORT="18080"
HSD_GITLAB_REMOTE_SSH_PORT="12222"

# Handshake API auth (for hsd ops over api-tunnel / direct URL).
HSD_API_KEY="changeme"
HSD_NODE_URL="http://127.0.0.1:12037"
HSD_WALLET_URL="http://127.0.0.1:12039"
HSD_LOCAL_NODE_PORT="12037"
HSD_LOCAL_WALLET_PORT="12039"

HSD_DRY_RUN="0"
