[Unit]
Description=Reverse SSH tunnel: expose local GitLab via Aliyun handshake
Documentation=file:///home/linkmore/handshake
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=linkmore
Group=linkmore
WorkingDirectory=/home/linkmore/handshake
Environment=HOME=/home/linkmore
ExecStart=/home/linkmore/handshake/hsd.sh tunnel
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
